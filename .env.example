# HARSI local development
# Copy to apps/api/.env and apps/web/.env.local as needed.
# Never commit real secrets.

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true

# Optional: Stripe test keys (checkout stays SIMULATED without them)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRADER=
STRIPE_PRICE_PRO=

# Optional: server-side market data (never expose to the browser)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
MARKET_DATA_PROVIDER=simulated

# Optional: economic calendar
FINNHUB_API_KEY=

# Email (forgot-password architecture; logs token in DEMO_MODE)
SMTP_URL=

# --- WEB (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
