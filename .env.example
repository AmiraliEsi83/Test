# HARSI AI Trading Platform Environment Variables Example
NODE_ENV=development
PORT=5001
JWT_SECRET=your_secure_random_jwt_secret_here
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/harsi?schema=public"

# Optional Broker Integrations (Server-Side Only - Never exposed to client)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ENV=paper # paper or live

OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_ENV=practice # practice or live

IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=5000
IBKR_ACCOUNT_ID=
