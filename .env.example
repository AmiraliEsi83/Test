# Copy to .env. Never commit the real file.
# SQLite paths are resolved from the prisma/ directory.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
ENCRYPTION_KEY="replace-with-another-random-string"
DEMO_MODE="true"
SEED_DEMO_PASSWORD="harsi-demo-only"

# PostgreSQL production example:
# DATABASE_URL="postgresql://harsi:harsi@localhost:5432/harsi?schema=public"

# Optional. Leave blank to show "not configured".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TRADER=""
STRIPE_PRICE_PRO=""
SMTP_URL=""
MARKET_DATA_PROVIDER=""
CALENDAR_PROVIDER=""

# Optional live broker credentials. Prefer the encrypted broker form over putting these in the client.
OANDA_API_TOKEN=""
OANDA_ACCOUNT_ID=""
OANDA_ENV="practice"
ALPACA_KEY_ID=""
ALPACA_SECRET=""
ALPACA_ENV="paper"
