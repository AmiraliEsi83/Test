# Public, non-secret demo defaults. Copy to .env for local dev.
# NEVER commit a real .env with keys.

# Demo seats (client-side only). Set to "false" to disable demo logins in production.
REACT_APP_DEMO_MODE=true

# Market data: "true" lets BTC/ETH use live Binance WS; FX/metals/equities always use the SIMULATED demo feed in this build.
REACT_APP_LIVE_FEED=true

# Economic calendar provider (unset = calendar shows NOT CONFIGURED, no fabricated events).
# REACT_APP_ECON_PROVIDER=

# Auth provider for production (unset = localStorage demo auth).
# REACT_APP_AUTH_PROVIDER=

# Stripe publishable key for production checkout (test mode ok).
# REACT_APP_STRIPE_KEY=

# Webhook target for Pro automation (server-side in production).
# HARSI_WEBHOOK_URL=

# Backend / database URLs for the full-stack deployment (see README).
# DATABASE_URL=
# REACT_APP_API_URL=
